#!/usr/bin/env bash
set -euo pipefail
umask 077

ENV_FILE=/etc/surrealdb/surreal-root.env
BACKUP_ROOT=/var/lib/surrealdb/backups
SURREAL_BIN=/usr/local/bin/surreal
ENDPOINT=http://10.0.0.104:8000
RETENTION_DAYS=${WARDEN_SURREAL_BACKUP_RETENTION_DAYS:-14}
TARGETS=(
  clyffy:ai_memory
  clyffy:knowledge_base
  clyffy:persona
  wardenclyffe:ai_memory
  wardenclyffe:main
)

if [[ ! -r "$ENV_FILE" ]]; then
  echo "missing env file: $ENV_FILE" >&2
  exit 2
fi
if [[ ! -x "$SURREAL_BIN" ]]; then
  echo "missing surreal cli: $SURREAL_BIN" >&2
  exit 2
fi

set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a

if [[ -z "${SURREAL_ROOT_PASS:-}" ]]; then
  echo "SURREAL_ROOT_PASS is not set" >&2
  exit 2
fi

stamp=$(date -u +%Y%m%dT%H%M%SZ)
out_dir="$BACKUP_ROOT/$stamp"
mkdir -p "$out_dir"
chmod 750 "$BACKUP_ROOT" "$out_dir"
manifest="$out_dir/manifest.tsv"
printf 'timestamp\tnamespace\tdatabase\tstatus\tbytes\tfile\tsha256\n' > "$manifest"

for target in "${TARGETS[@]}"; do
  ns=${target%%:*}
  db=${target#*:}
  file="$out_dir/${ns}_${db}.surql"
  stderr="$file.stderr"
  if "$SURREAL_BIN" export \
      --endpoint "$ENDPOINT" \
      --username root \
      --password "$SURREAL_ROOT_PASS" \
      --namespace "$ns" \
      --database "$db" \
      "$file" > /dev/null 2> "$stderr"; then
    rm -f "$stderr"
    gzip -9 "$file"
    sha=$(sha256sum "$file.gz" | awk '{print $1}')
    bytes=$(wc -c < "$file.gz")
    printf '%s\t%s\t%s\tok\t%s\t%s\t%s\n' \
      "$stamp" "$ns" "$db" "$bytes" "$file.gz" "$sha" >> "$manifest"
  else
    printf '%s\t%s\t%s\tfailed\t0\t%s\t\n' \
      "$stamp" "$ns" "$db" "$stderr" >> "$manifest"
  fi
done

find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -mtime +"$RETENTION_DAYS" -print -exec rm -rf {} \;
cat "$manifest"
