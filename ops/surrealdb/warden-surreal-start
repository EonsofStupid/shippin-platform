#!/usr/bin/env bash
set -euo pipefail

ENV_FILE=/etc/surrealdb/surreal-root.env

if [[ ! -r "$ENV_FILE" ]]; then
  echo "missing env file: $ENV_FILE" >&2
  exit 2
fi

set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a

if [[ -z "${SURREAL_ROOT_PASS:-}" ]]; then
  echo "SURREAL_ROOT_PASS is not set" >&2
  exit 2
fi

export SURREAL_USER=root
export SURREAL_PASS="$SURREAL_ROOT_PASS"
export SURREAL_PATH=surrealkv:///var/lib/surrealdb

exec /usr/local/bin/surreal start \
  --bind 10.0.0.104:8000 \
  --log info \
  --deny-all \
  --allow-funcs \
  --allow-net
