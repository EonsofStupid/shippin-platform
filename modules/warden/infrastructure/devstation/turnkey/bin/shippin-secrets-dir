#!/usr/bin/env bash
# Print the volatile runtime keyring directory.
# Canonical: /run/shippin-secrets. Compatibility: /run/warden-secrets.
set -euo pipefail
if [[ -n "${SHIPPIN_SECRETS_DIR:-}" ]]; then
  printf '%s\n' "$SHIPPIN_SECRETS_DIR"
  exit 0
fi
if [[ -d /run/shippin-secrets ]]; then
  printf '%s\n' /run/shippin-secrets
  exit 0
fi
if [[ -d /run/warden-secrets ]]; then
  printf '%s\n' /run/warden-secrets
  exit 0
fi
printf '%s\n' /run/shippin-secrets
