#!/usr/bin/env bash
set -euo pipefail
if [[ "${SHIPPIN_SECRET_VIEW_ALLOWED:-${WARDEN_SECRET_VIEW_ALLOWED:-0}}" != "1" ]]; then
  echo "refusing to print secret; set SHIPPIN_SECRET_VIEW_ALLOWED=1 for deliberate break-glass viewing" >&2
  exit 3
fi
name="${1:-}"
path="$(shippin-secret-path "$name")"
exec cat -- "$path"
