#!/usr/bin/env bash
set -euo pipefail
source /etc/profile.d/warden-workspace.sh
export PATH="/opt/node/bin:/home/wardenop/.npm-global/bin:/home/wardenop/.local/bin:/home/wardenop/.cargo/bin:$PATH"
printf 'host=%s user=%s ip=%s\n' "$(hostname)" "$(whoami)" "$(hostname -I | awk '{print $1}')"
printf 'workspace_root=%s project_root=%s\n' "$WARDEN_WORKSPACE_ROOT" "$WARDEN_PROJECT_ROOT"
printf 'w_root_label=%s\n' "$(findmnt -n -o LABEL --target "$WARDEN_WORKSPACE_ROOT")"
printf 'node=%s codex=%s claude=%s gh=%s\n' \
  "$(node --version 2>/dev/null || echo missing)" \
  "$(codex --version 2>/dev/null || echo missing)" \
  "$(claude --version 2>/dev/null || echo missing)" \
  "$(gh --version 2>/dev/null | head -n 1 || echo missing)"
warden-devstation-code-status || true
git -C "$WARDEN_PROJECT_ROOT" status --short --branch | head -80 || true
