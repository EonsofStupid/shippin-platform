# Copy to secrets/proxmox.env and fill in the token values from Infisical.
# secrets/proxmox.env is git-ignored. Do NOT commit real token values.
PROXMOX_HOST=
PROXMOX_PORT=8006
PROXMOX_NODE=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_TLS=true
# Optional path to a PEM CA certificate for a privately issued server certificate.
PROXMOX_CA_CERT=
