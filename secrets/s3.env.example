# S3-compatible backup connector (R2 / MinIO / AWS / B2)
# Copy to secrets/s3.env (gitignored) or save from /admin/proxmox → Backup.
# Never commit real values. Never paste them into chat.

S3_PROVIDER=r2
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=shippin-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true
S3_PREFIX=shippin-backups
RESTIC_PASSWORD=
