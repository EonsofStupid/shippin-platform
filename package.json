{
  "name": "@shippin/platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shippin infrastructure management panel",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "check:quality": "biome check src/domains/warden/proxmox src/domains/warden/data/views/DataBrowserView.tsx src/domains/warden/fleet/views/OrderDevstationView.tsx src/domains/warden/fleet/views/WorkspacesView.tsx src/domains/warden/overview/views/OverviewView.tsx src/lib/api.ts src/lib/api.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/domains/warden/proxmox/proxmox.svc.test.mjs src/lib/api.test.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "setup": "bash scripts/dev/setup-prerelease.sh",
    "stack": "bash scripts/dev/run-stack.sh",
    "stop": "bash scripts/dev/stop-stack.sh",
    "verify:slice0": "bash scripts/dev/verify-slice0.sh",
    "hooks:install": "lefthook install"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "react": "^18.3.1",
    "react-aria-components": "^1.5.0",
    "react-dom": "^18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tanstack/router-plugin": "1.168.48",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "lefthook": "2.2.2",
    "typescript": "^5.6.3",
    "vite": "8.3.5"
  }
}
